# Copy to your shell profile or the cloud environment's variables. Never commit real values.
IG_API_KEY=
IG_USERNAME=
IG_PASSWORD=
IG_ACC_TYPE=DEMO          # DEMO or LIVE
IG_ACC_NUMBER=            # optional: account to switch to after login
# IG_LIVE_API_KEY= / IG_DEMO_API_KEY= ... per-environment overrides are supported
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
MASSIVE_API_KEY=          # optional: free Massive (Polygon) key for `mlab datasets build massive-1m`; a network secret works too
SEC_USER_AGENT="Your Name you@example.com"
MLAB_CACHE_MAX_MB=750
# Where journal, reports and caches live. Default: /mnt/project-files/market-lab if it exists, else the checkout.
# MLAB_DATA_DIR=
